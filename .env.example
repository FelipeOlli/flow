# NextAuth
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=# gere com: openssl rand -base64 32

# Credenciais de acesso ao app
AUTH_USERNAME=admin
AUTH_PASSWORD=suasenhasegura
AUTH_USER_EMAIL=seuemail@gmail.com  # usado para RSVP de eventos no Google Calendar

# Google OAuth (console.cloud.google.com) — usado apenas para conectar o Google Calendar
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# Cron secret (protege o endpoint de migração)
CRON_SECRET=# gere com: openssl rand -base64 32

# API da secretária (leitura) — access: Authorization: Bearer <token>
# Token único, só leitura. Gere com: openssl rand -base64 32
FLOW_API_TOKEN=

# API da secretária (escrita) — access: Authorization: Bearer <token>
# Token que além de ler cria/edita/conclui eventos. Gere com: openssl rand -base64 32
# Vazio = escrita desabilitada (o MCP só consulta).
# No conector do claude.ai, use ESTE token para o Claude poder criar eventos.
FLOW_API_WRITE_TOKEN=

# Secretária de IA (avisos automáticos no Telegram)
# SECRETARIA_ENABLED=off  desliga tudo
# SECRETARIA_SILENCE_START=21:30   # nada é enviado a partir daqui
# SECRETARIA_SILENCE_END=07:00     # ... até aqui
# SECRETARIA_RESUMO_HORA=07:30     # resumo do dia
# SECRETARIA_COBRANCA_HORA=08:00   # cobrança das delegações atrasadas
# SECRETARIA_FECHAMENTO_HORA=20:00 # fechamento do dia
# SECRETARIA_REGRAS_AGENDA=off     # ignora as janelas por agenda (CF só em horário comercial etc.)

# Fuso horário padrão do usuário
DEFAULT_TIMEZONE=America/Sao_Paulo

# Web Push (PWA — notificações no navegador/iOS)
# Gere as chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seuemail@gmail.com

# Telegram (notificações no Telegram)
# 1. Crie um bot no @BotFather e copie o token
# 2. Mande /start pro bot, depois acesse:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    e copie o "id" dentro de "chat"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot de entrada (opcional — preenche se quiser controlar a agenda pelo Telegram)
# 1. TELEGRAM_USER_ID: mesmo endpoint acima, copie o "id" dentro de "from"
# 2. TELEGRAM_WEBHOOK_SECRET: gere com `openssl rand -base64 32`
# 3. TELEGRAM_WEBHOOK_URL: https://<seu-dominio>/api/telegram/webhook
#    (em dev, use ngrok ou similar pra expor HTTPS)
TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# Anthropic (Claude) — usado na criação de evento por imagem/arquivo com IA
ANTHROPIC_API_KEY=
