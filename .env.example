# NextAuth
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=# gere com: openssl rand -base64 32

# Credenciais de acesso ao app
AUTH_USERNAME=admin
AUTH_PASSWORD=suasenhasegura
AUTH_USER_EMAIL=seuemail@gmail.com  # usado para RSVP de eventos no Google Calendar

# Google OAuth (console.cloud.google.com) — usado apenas para conectar o Google Calendar
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# Cron secret (protege o endpoint de migração)
CRON_SECRET=# gere com: openssl rand -base64 32

# Fuso horário padrão do usuário
DEFAULT_TIMEZONE=America/Sao_Paulo
